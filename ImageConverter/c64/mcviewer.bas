10 REM ---------------------------------------------
20 REM  CASASOFT MULTICOLOR BITMAP VIEWER
30 REM  carica i file .BM.PRG .SC.PRG .CO.PRG generati
40 REM  da ImageConverter e mostra l'immagine sul VIC-II
50 REM  premere INVIO per tornare alla configurazione
60 REM  originale
70 REM ---------------------------------------------
80 DV=8:REM numero periferica disco
90 PRINT CHR$(147)
100 PRINT "CASASOFT - MULTICOLOR VIEWER"
110 PRINT
120 INPUT "NOME IMMAGINE (SENZA ESTENSIONE)";F$
130 PRINT
140 PRINT "CARICAMENTO IN CORSO..."
150 N$=F$+".BM":GOSUB 1000
160 N$=F$+".SC":GOSUB 1000
170 N$=F$+".CO":GOSUB 1000
180 PRINT "FATTO. PREMI INVIO PER VISUALIZZARE."
190 FOR T=1 TO 800:NEXT T
200 REM --- SALVA CONFIGURAZIONE VIC/CIA ORIGINALE ---
210 OB=PEEK(53265):OM=PEEK(53270):OP=PEEK(53272)
220 OC=PEEK(56576):OF=PEEK(53280):OG=PEEK(53281)
230 REM --- BANCO VIC 3 ($C000-$FFFF) ---
240 POKE 56576,PEEK(56576) AND 252
250 REM --- SCREEN A $C000 (OFFSET 0) BITMAP A $E000 (OFFSET $2000) ---
260 POKE 53272,8
270 REM --- ABILITA BITMAP MODE (BIT BMM DI $D011) ---
280 POKE 53265,PEEK(53265) OR 32
290 REM --- ABILITA MULTICOLOR MODE (BIT MCM DI $D016) ---
300 POKE 53270,PEEK(53270) OR 16
310 REM --- BORDO/SFONDO (MODIFICABILI A PIACERE) ---
320 POKE 53280,0:POKE 53281,0
330 REM --- ATTENDI INVIO ---
340 GET K$:IF K$<>CHR$(13) THEN 340
350 REM --- RIPRISTINA CONFIGURAZIONE ORIGINALE ---
360 POKE 53265,OB:POKE 53270,OM:POKE 53272,OP
370 POKE 56576,OC:POKE 53280,OF:POKE 53281,OG
380 PRINT CHR$(147)
390 END
400 REM ---------------------------------------------
1000 REM --- SUBROUTINE: carica il file N$ all'indirizzo
1010 REM     contenuto nella sua intestazione (LOAD ",1")
1020 REM     senza interrompere il programma BASIC
1030 LN=LEN(N$)
1040 FOR I=1 TO LN
1050 POKE 828+I-1,ASC(MID$(N$,I,1))
1060 NEXT I
1070 POKE 780,LN:POKE 781,828 AND 255:POKE 782,INT(828/256)
1080 SYS 65469:REM SETNAM
1090 POKE 780,2:POKE 781,DV:POKE 782,1
1100 SYS 65466:REM SETLFS (SA=1 -> usa indirizzo del file)
1110 POKE 780,0:POKE 781,0:POKE 782,0
1120 SYS 65493:REM LOAD
1130 SYS 65463:REM READST
1140 IF PEEK(780)<>0 THEN PRINT "ERRORE CARICAMENTO ";N$:END
1150 RETURN

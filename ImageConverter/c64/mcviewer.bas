{renumber}
{step:10}
	REM ---------------------------------------------
	REM  CASASOFT MULTICOLOR BITMAP VIEWER
	REM  carica i file .BM.PRG .SC.PRG .CO.PRG generati
	REM  da ImageConverter e mostra l'immagine sul VIC-II
	REM  premere INVIO per tornare alla configurazione
	REM  originale
	REM ---------------------------------------------
{nice:100}	
	IF LD=0 THEN GOSUB {:init}: LD=1: LOAD F$+".BM",DV,1
	IF LD=1 THEN PRINT ".";: LD=LD+1: LOAD F$+".SC",DV,1
	IF LD=2 THEN PRINT ".";: LD=LD+1: LOAD F$+".CO",DV,1
	IF LD=3 THEN PRINT ".";: LD=LD+1: LOAD F$+".BG",DV,1
	REM --- SALVA CONFIGURAZIONE VIC/CIA ORIGINALE ---
	OB=PEEK(53265):OM=PEEK(53270):OP=PEEK(53272)
	OC=PEEK(56576):OF=PEEK(53280):OG=PEEK(53281)
	REM --- BANCO VIC 3 ($C000-$FFFF) ---
	POKE 56576,PEEK(56576) AND 252
	REM --- SCREEN A $C000 (OFFSET 0) BITMAP A $E000 (OFFSET $2000) ---
	POKE 53272,8
	REM --- ABILITA BITMAP MODE (BIT BMM DI $D011) ---
	POKE 53265,PEEK(53265) OR 32
	REM --- ABILITA MULTICOLOR MODE (BIT MCM DI $D016) ---
	POKE 53270,PEEK(53270) OR 16
	REM --- BORDO/SFONDO (MODIFICABILI A PIACERE) ---
	POKE 53280,0:POKE 53281,0
	REM --- ATTENDI INVIO ---
{:wait}	
	GET K$:IF K$<>CHR$(13) THEN {:wait}
	REM --- RIPRISTINA CONFIGURAZIONE ORIGINALE ---
	POKE 53265,OB:POKE 53270,OM:POKE 53272,OP
	POKE 56576,OC:POKE 53280,OF:POKE 53281,OG
	PRINT CHR$(147)
	END
{nice:1000}
	REM ---------------------------------------------
	REM --- INIT
{:init}
	DV=8:REM numero periferica disco
	PRINT CHR$(147)
	PRINT "CASASOFT MULTICOLOR VIEWER"
	PRINT
	INPUT "NOME IMMAGINE (SENZA EXT)";F$
	PRINT
	PRINT "CARICAMENTO IN CORSO.";
	RETURN
